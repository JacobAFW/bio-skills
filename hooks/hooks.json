{
  "description": "bio-skills hooks: git-guard blocks data/secrets before commit/push (PreToolUse); genericity-guard flags untagged hardcoding after edits to core pipeline code (PostToolUse).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/genericity-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
